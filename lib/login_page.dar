import 'package:flutter/material.dart';
import 'api_service.dart';
import 'famille_page.dart';

class LoginPage extends StatefulWidget {
  const LoginPage({super.key});

  @override
  State<LoginPage> createState() => _LoginPageState();
}

class _LoginPageState extends State<LoginPage> {
  final _emailController = TextEditingController();
  final _passwordController = TextEditingController();
  bool _isRegisterMode = false;
  bool _loading = false;
  String? _errorMessage;

  Future<void> _submit() async {
    setState(() {
      _loading = true;
      _errorMessage = null;
    });

    final result = _isRegisterMode
        ? await ApiService.register(
            _emailController.text, _passwordController.text)
        : await ApiService.login(
            _emailController.text, _passwordController.text);

    if (!mounted) return;
    setState(() => _loading = false);

    if (result['ok'] == true) {
      Navigator.pushReplacement(
        context,
        MaterialPageRoute(builder: (_) => const FamillePage()),
      );
    } else {
      setState(() {
        _errorMessage = result['message']?.toString() ?? 'Échec authentification';
      });
    }
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      appBar: AppBar(
        title: Text(_isRegisterMode ? 'Créer un compte' : 'Connexion'),
      ),
      body: Padding(
        padding: const EdgeInsets.all(16),
        child: Column(
          mainAxisAlignment: MainAxisAlignment.center,
          children: [
            TextField(
              controller: _emailController,
              keyboardType: TextInputType.emailAddress,
              decoration: const InputDecoration(labelText: 'Email'),
            ),
            const SizedBox(height: 12),
            TextField(
              controller: _passwordController,
              obscureText: true,
              decoration: const InputDecoration(
                  labelText: 'Mot de passe (6 caractères min.)'),
            ),
            const SizedBox(height: 16),
            if (_errorMessage != null)
              Padding(
                padding: const EdgeInsets.only(bottom: 12),
                child: Text(
                  _errorMessage!,
                  style: const TextColorStyle(),
                ),
              ),
            SizedBox(
              width: double.infinity,
              child: ElevatedButton(
                onPressed: _loading ? null : _submit,
                child: _loading
                    ? const SizedBox(
                        height: 20,
                        width: 20,
                        child: CircularProgressIndicator(strokeWidth: 2),
                      )
                    : Text(_isRegisterMode ? "S'inscrire" : 'Se connecter'),
              ),
            ),
            TextButton(
              onPressed: () {
                setState(() {
                  _isRegisterMode = !_isRegisterMode;
                  _errorMessage = null;
                });
              },
              child: Text(_isRegisterMode
                  ? 'Déjà un compte ? Se connecter'
                  : 'Pas de compte ? Créer un compte'),
            ),
          ],
        ),
      ),
    );
  }
}

class TextColorStyle extends TextStyle {
  const TextColorStyle() : super(color: Colors.red);
}
